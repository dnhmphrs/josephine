{
  "name": "josephine-shen",
  "version": "1.0.0",
  "private": true,
  "description": "Josephine Shen - identity card and compressed CV, rendered entirely in WebGL. Static, bilingual (EN/\u4e2d).",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "dev": "rollup -c -w",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c",
    "preview": "serve dist",
    "lint": "eslint .",
    "check": "node scripts/check.mjs",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "postcss": "^8.4.35",
    "rollup": "^4.9.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^1.1.1",
    "serve": "^14.2.1"
  }
}
